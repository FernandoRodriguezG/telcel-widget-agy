<?xml version="1.0" encoding="utf-8"?>
<!-- El número cifrado depende de una llave del Android Keystore que no viaja en respaldos -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
